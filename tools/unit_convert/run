def emit(payload):
    print(json.dumps(payload, ensure_ascii=False))


def normalize(unit):
    raw = str(unit).strip()
    if raw in ("B", "Byte", "Bytes"):
        return "byte"
    return (
        raw.lower()
        .replace("°", "")
        .replace(" ", "")
        .replace("_", "")
        .replace("-", "")
    )


def resolve(unit):
    key = normalize(unit)
    key = ALIASES.get(key, key)
    if key in TEMPERATURE_UNITS:
        return "temperature", key
    for category, table in LINEAR_UNITS.items():
        if key in table:
            return category, key
    return None, None


def to_celsius(value, unit):
    if unit == "c":
        return value
    if unit == "f":
        return (value - 32.0) * 5.0 / 9.0
    return value - 273.15


def from_celsius(value, unit):
    if unit == "c":
        return value
    if unit == "f":
        return value * 9.0 / 5.0 + 32.0
    return value + 273.15


def format_value(value):
    if value != 0 and (abs(value) < 1e-9 or abs(value) >= 1e15):
        return f"{value:.10g}"
    if value == int(value):
        return str(int(value))
    return f"{value:.10f}".rstrip("0").rstrip(".")


def main():
    try:
        params = json.load(sys.stdin)
    except Exception:
        params = {}

    if not isinstance(params, dict):
        params = {}

    try:
        value = float(params.get("value"))
    except (TypeError, ValueError):
        emit({"success": False, "error": "Provide a numeric 'value'."})
        return

    from_raw = str(params.get("from") or "").strip()
    to_raw = str(params.get("to") or "").strip()
    if not from_raw or not to_raw:
        emit({"success": False, "error": "Provide both 'from' and 'to' units."})
        return

    from_category, from_unit = resolve(from_raw)
    to_category, to_unit = resolve(to_raw)
    if from_category is None:
        emit({"success": False, "error": f"Unknown unit '{from_raw}'."})
        return
    if to_category is None:
        emit({"success": False, "error": f"Unknown unit '{to_raw}'."})
        return
    if from_category != to_category:
        emit({
            "success": False,
            "error": (
                f"Cannot convert {from_raw} ({from_category}) to "
                f"{to_raw} ({to_category})."
            ),
        })
        return

    if from_category == "temperature":
        celsius = to_celsius(value, from_unit)
        if celsius < -273.15:
            emit({"success": False, "error": "Value is below absolute zero."})
            return
        result = from_celsius(celsius, to_unit)
    else:
        table = LINEAR_UNITS[from_category]
        result = value * table[from_unit] / table[to_unit]

    if result != result or result in (float("inf"), float("-inf")):
        emit({"success": False, "error": "Result is not a finite number."})
        return

    emit({
        "success": True,
        "result": (
            f"{format_value(value)} {from_raw} = "
            f"{format_value(result)} {to_raw}"
        ),
    })


if __name__ == "__main__":
    main()
