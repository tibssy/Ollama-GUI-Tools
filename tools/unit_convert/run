    "angle": {
        "rad": 1.0,
        "deg": 0.017453292519943295,
        "grad": 0.015707963267948967,
    },
}

TEMPERATURE_UNITS = {"c", "f", "k"}

ALIASES = {
    "millimeter": "mm",
