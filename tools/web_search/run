#!/usr/bin/env python3
"""Search the web with DuckDuckGo's lite HTML endpoint."""

import json
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from html.parser import HTMLParser

USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/124.0 Safari/537.36"
)
MAX_SNIPPET_CHARS = 320


def emit(payload):
    print(json.dumps(payload, ensure_ascii=False))


def clean_text(text):
    return re.sub(r"\s+", " ", text).strip()


class LiteParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.links = []
        self.snippets = []
        self._in_link = False
        self._link_href = ""
        self._link_text = []
        self._in_snippet = False
        self._snippet_text = []

    def handle_starttag(self, tag, attrs):
        attributes = dict(attrs)
        classes = (attributes.get("class") or "").split()
        if tag == "a" and "result-link" in classes:
            self._in_link = True
            self._link_href = attributes.get("href", "")
            self._link_text = []
        elif tag == "td" and "result-snippet" in classes:
            self._in_snippet = True
            self._snippet_text = []
        elif tag == "br" and self._in_snippet:
            self._snippet_text.append(" ")

    def handle_endtag(self, tag):
        if tag == "a" and self._in_link:
            title = clean_text("".join(self._link_text))
            if title:
                self.links.append((title, self._link_href))
            self._in_link = False
        elif tag == "td" and self._in_snippet:
            self.snippets.append(clean_text("".join(self._snippet_text)))
            self._in_snippet = False

    def handle_data(self, data):
        if self._in_link:
            self._link_text.append(data)
        if self._in_snippet:
            self._snippet_text.append(data)


def decode_result_url(href):
    href = href.strip()
    if href.startswith("//"):
        href = "https:" + href
    parsed = urllib.parse.urlparse(href)
    if parsed.netloc.endswith("duckduckgo.com") and parsed.path.startswith("/l/"):
        target = urllib.parse.parse_qs(parsed.query).get("uddg")
        if target:
            return target[0]
    return href


def fetch_lite(query):
    url = "https://lite.duckduckgo.com/lite/?" + urllib.parse.urlencode({"q": query})
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT,
            "Accept": "text/html,application/xhtml+xml",
            "Accept-Language": "en-US,en;q=0.9",
        },
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        if response.status in (202, 429):
            raise RuntimeError("DuckDuckGo rate-limited the request")
        charset = response.headers.get_content_charset() or "utf-8"
        html = response.read(2_000_000).decode(charset, "replace")

    parser = LiteParser()
    parser.feed(html)
    parser.close()

    results = []
    for index, (title, href) in enumerate(parser.links):
        target = decode_result_url(href)
        if not target.startswith(("http://", "https://")):
            continue
        snippet = parser.snippets[index] if index < len(parser.snippets) else ""
        results.append({"title": title, "url": target, "snippet": snippet})
    return results


def fetch_ddgs(query, max_results):
    try:
        from ddgs import DDGS
    except ImportError:
        try:
            from duckduckgo_search import DDGS
        except ImportError:
            return []
    try:
        raw = list(DDGS(timeout=15).text(query, max_results=max_results))
    except Exception:
        return []
    results = []
    for item in raw:
        url = item.get("href") or item.get("url") or ""
        if not url.startswith(("http://", "https://")):
            continue
        results.append(
            {
                "title": item.get("title") or "",
                "url": url,
                "snippet": item.get("body") or "",
            }
        )
    return results


def main():
    try:
        params = json.load(sys.stdin)
    except Exception:
        params = {}

    query = str(params.get("query") or "").strip()
    if not query:
        emit({"success": False, "error": "Provide a 'query' string."})
        return

    try:
        max_results = int(params.get("max_results") or 5)
    except (TypeError, ValueError):
        max_results = 5
    max_results = max(1, min(max_results, 10))

    errors = []
    try:
        results = fetch_lite(query)
    except Exception as exc:
        errors.append(f"DuckDuckGo lite: {exc}")
        results = []

    if not results:
        results = fetch_ddgs(query, max_results)

    if not results:
        detail = "; ".join(errors) if errors else "no results returned"
        emit({"success": False, "error": f"Web search failed: {detail}"})
        return

    lines = []
    for index, result in enumerate(results[:max_results], 1):
        title = clean_text(result["title"]) or "(untitled)"
        snippet = clean_text(result["snippet"])
        if len(snippet) > MAX_SNIPPET_CHARS:
            snippet = snippet[:MAX_SNIPPET_CHARS].rstrip() + "…"
        lines.append(f"{index}. {title}")
        lines.append(f"   {result['url']}")
        if snippet:
            lines.append(f"   {snippet}")

    emit({"success": True, "result": "\n".join(lines)})


if __name__ == "__main__":
    main()
